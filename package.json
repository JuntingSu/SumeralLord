{
  "name": "digital-lord",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "backend",
    "frontend",
    "train"
  ],
  "scripts": {
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "test:backend": "npm run test -w backend",
    "typecheck:backend": "npm run typecheck -w backend",
    "typecheck:frontend": "npm run typecheck -w frontend",
    "build:frontend": "npm run build -w frontend",
    "lint": "eslint packages/shared/src",
    "test:shared": "npm run test -w @dl/shared",
    "test:train": "npm run test -w @dl/train"
  },
  "devDependencies": {
    "eslint": "^10.8.1",
    "playwright-core": "^1.62.1",
    "typescript-eslint": "^8.67.0"
  }
}
